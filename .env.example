# =============================================================================
# .env.example  —  Single source of truth for all environment variables
# Copy to .env and fill in real values.  Never commit .env.
#
# Consumed by:
#   backend/   → Spring Boot (via backend/env/.env.*.properties which mirror
#                these values for each profile)
#   frontend/  → Vite (envDir set to repo root, reads VITE_* vars from here)
#   scripts/   → create-free-user.sh / create-master-player.sh / setup-e2e-users.sh
# =============================================================================

# ── Backend: Database ─────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/collaboration
DB_USERNAME=postgres
DB_PASSWORD=password

# ── Backend: JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars

# ── Backend: Stripe ───────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Backend: OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Backend: GitHub Webhooks ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Backend: Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Frontend: Vite ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── E2E Scripts ───────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:8080

# PRO master account (used by scripts/create-master-player.sh)
MASTER_EMAIL=master_player@syncdoc.dev
MASTER_PASSWORD=change-me
MASTER_DISPLAY_NAME=Master Player

# Free test account (used by scripts/create-free-user.sh)
FREE_EMAIL=free_tester@syncdoc.dev
FREE_PASSWORD=change-me
FREE_DISPLAY_NAME=Free Tester
